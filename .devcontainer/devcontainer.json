{
  "name": "Data engineering och Agila metoder",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/azure-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/kubectl-helm-minikube:1": {
      "version": "latest",
      "helm": "latest",
      "minikube": "none"
    }
  },
  "postCreateCommand": "curl -LsSf https://astral.sh/uv/install.sh | sh && echo 'export PATH=\"$HOME/.local/bin:$PATH\"' >> ~/.bashrc && $HOME/.local/bin/uv pip install --system duckdb pandas",
  "postStartCommand": "bash -lc 'echo \"--- Environment check ---\"; python3 --version; uv --version; docker --version; az --version | head -n 1; kubectl version --client; echo \"-------------------------\"'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "ms-vscode.azure-account",
        "mhutchie.git-graph"
      ]
    },
    "codespaces": {
      "repositories": {
        "ithogskolan-aim25/team1": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team2": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team3": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team4": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team5": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team6": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team7": { "permissions": { "contents": "write" } },
        "ithogskolan-aim25/team8": { "permissions": { "contents": "write" } }
      }
    }
  },
  "forwardPorts": [
    8000,
    5432,
    8080
  ],
  "portsAttributes": {
    "5432": {
      "label": "Postgres"
    },
    "8000": {
      "label": "FastAPI app"
    },
    "8080": {
      "label": "Adminer"
    }
  },
  "hostRequirements": {
    "cpus": 2
  },
  "remoteUser": "vscode"
}
